<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="scalar"
          fetch="https://github.com/projectscalar"
          revision="16" />

  <!-- Remove projects -->
  <remove-project name="LineageOS/android_build_soong" />
  <remove-project name="LineageOS/android_frameworks_av" />
  <remove-project name="LineageOS/android_frameworks_base" />
  <remove-project name="LineageOS/android_frameworks_native" />
  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <remove-project name="LineageOS/android_system_core" />
  <remove-project name="LineageOS/android_vendor_lineage" />

  <!-- Build -->
  <project path="build/soong" name="build_soong" remote="scalar" />

  <!-- Frameworks -->
  <project path="frameworks/av" name="frameworks_av" remote="scalar" />
  <project path="frameworks/base" name="frameworks_base" remote="scalar" />
  <project path="frameworks/native" name="frameworks_native" remote="scalar" />

  <!-- Packages -->
  <project path="packages/apps/ParanoidSense" name="packages_apps_ParanoidSense" remote="scalar" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" remote="scalar" />

  <!-- System -->
  <project path="system/core" name="system_core" remote="scalar" />

  <!-- Vendor -->
  <project path="vendor/lineage" name="vendor_lineage" remote="scalar" />

</manifest>
